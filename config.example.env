# Copy this file to .env, then replace the API key value.
COHERE_API_KEY=replace_with_your_cohere_api_key
COHERE_MODEL=command-a-plus-05-2026

# English defaults
SPEECH_LANGUAGE=en-US
TTS_LANGUAGE=en
ASSISTANT_LANGUAGE=English

# For Arabic, use:
# SPEECH_LANGUAGE=ar-SA
# TTS_LANGUAGE=ar
# ASSISTANT_LANGUAGE=Arabic

OUTPUT_AUDIO=output/assistant_response.mp3
MICROPHONE_INDEX=
LISTEN_TIMEOUT=8
PHRASE_TIME_LIMIT=20

